# The vault first: it holds every plaintext value the tool has ever seen, and
# a COPY that swept it into an image would put that in every layer shipped.
*.db
*.db-journal

# Local configuration, which is where a key or a token ends up. Settings reads
# `.env` from the working directory, so one copied into an image would also
# quietly override that image's own configuration wherever it ran.
.env
.env.*
!.env.example

.git
.github
.venv
.idea
.claude
.pytest_cache
__pycache__
*.pyc
*.egg-info

# Weights are baked by the `full` target rather than copied, so a local cache
# would only make the build context gigabytes larger.
models/

# Not needed to run the gateway.
tests/
eval/
docs/
