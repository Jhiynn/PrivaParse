# Copy to .env and edit. Every setting is optional; these are the defaults.
# The .env file is read automatically — no need to export anything.

# auto | cpu | cuda | cuda:0
# "auto" picks CUDA when it is usable. An explicit "cuda" on a machine without
# CUDA is an error, never a silent downgrade to CPU.
PRIVAPARSE_DEVICE=cpu

# hybrid = GLiNER2 for names + rules for email/phone (needs model weights)
# regex  = email and phone only, no model, no download
PRIVAPARSE_DETECTOR=hybrid

# The vault. Contains every real name, address and number the tool has seen.
PRIVAPARSE_DB_PATH=privaparse.db

# Where model weights are cached. Keeps them in the project instead of ~/.cache.
PRIVAPARSE_MODEL_DIR=models/gliner

# Score cutoff for the model. Lower finds more and invents more.
PRIVAPARSE_THRESHOLD=0.5

# Window the document is split into for the model. This is a recall setting as
# much as a speed one — longer chunks dilute scores and lose names.
PRIVAPARSE_CHUNK_CHARS=512

# Scan fenced code, inline code and URLs too. Off by default so that a sample
# address in a code block is not pseudonymised.
PRIVAPARSE_SCAN_CODE=false

# DEBUG | INFO | WARNING | ERROR
PRIVAPARSE_LOG_LEVEL=INFO
